# nice!60 regional reactive RGB - independent Zephyr module switch
# The old "depends on ZMK" was intentionally removed: there is no
# general CONFIG_ZMK symbol in the ZMK app/Kconfig we inspected.

config NICE60_REACTIVE_RGB
    bool "Reactive per-region nice!60 RGB lighting"
    default n
    depends on DT_HAS_WORLDSEMI_WS2812_SPI_ENABLED
    select LED_STRIP
    help
      Drive the twelve on-board RGB LEDs from physical key events.
      Requires the legacy ZMK underglow engine to be disabled.

config NICE60_REACTIVE_RGB_AFTERGLOW_MS
    int "Reactive RGB afterglow (milliseconds)"
    depends on NICE60_REACTIVE_RGB
    range 100 10000
    default 1000
