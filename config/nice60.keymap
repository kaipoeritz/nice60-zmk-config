#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/reset.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Normal keyboard layout
            bindings = <
                &gresc     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH
                &kp CLCK   &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT             &kp RET
                &kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH                      &kp RSHFT
                &kp LCTRL  &kp LGUI  &kp LALT                     &kp SPACE                     &kp RALT  &kp RGUI  &mo 1     &kp RCTRL
            >;
        };

        rgb_layer {
            // Fn layer:
            // WASD = arrow keys
            // H = Home, E = End
            // U = Page Up, J = Page Down
            // Backspace = Delete
            // Numbers = F1-F12
            // Bluetooth profiles remain unchanged

            bindings = <
                &bt BT_CLR    &kp F1   &kp F2   &kp F3   &kp F4          &kp F5          &kp F6          &kp F7          &kp F8       &kp F9  &kp F10  &kp F11  &kp F12  &kp DEL
                &bt BT_SEL 0  &trans   &kp UP   &kp END  &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_BRI &kp PG_UP      &trans       &trans  &trans    &trans    &trans   &trans
                &bt BT_SEL 1  &kp LEFT &kp DOWN &kp RIGHT &rgb_ug RGB_HUD &rgb_ug RGB_SAD &kp HOME       &kp PG_DN      &trans       &trans  &trans    &trans    &rgb_ug RGB_EFF
                &bt BT_SEL 2  &trans   &trans   &trans   &trans          &trans          &trans          &trans          &trans       &trans  &trans    &trans
                &bt BT_SEL 3  &trans   &trans   &rgb_ug RGB_TOG                            &kp PSCRN                        &trans       &trans  &kp DEL
            >;
        };
    };
};
